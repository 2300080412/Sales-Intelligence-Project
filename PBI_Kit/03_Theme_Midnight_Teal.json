{
  "name": "Midnight Teal",
  "dataColors": ["#1D9A8A", "#F2A541", "#3D5A80", "#E4572E", "#98C1D9", "#6D597A", "#B5CDA3", "#EE6C4D"],
  "background": "#FFFFFF",
  "foreground": "#1B263B",
  "tableAccent": "#1D9A8A",
  "good": "#1D9A8A",
  "neutral": "#F2A541",
  "bad": "#E4572E",
  "maximum": "#1D9A8A",
  "center": "#F2A541",
  "minimum": "#E4572E",
  "textClasses": {
    "title":   { "fontFace": "Segoe UI Semibold", "fontSize": 14, "color": "#1B263B" },
    "label":   { "fontFace": "Segoe UI", "fontSize": 10, "color": "#415A77" },
    "callout": { "fontFace": "Segoe UI Semibold", "fontSize": 28, "color": "#1B263B" },
    "header":  { "fontFace": "Segoe UI Semibold", "fontSize": 12, "color": "#1B263B" }
  },
  "visualStyles": {
    "*": {
      "*": {
        "title": [{ "show": true, "fontColor": { "solid": { "color": "#1B263B" } }, "fontFamily": "Segoe UI Semibold" }],
        "border": [{ "show": true, "color": { "solid": { "color": "#E0E1DD" } }, "radius": 8 }],
        "background": [{ "show": true, "color": { "solid": { "color": "#FFFFFF" } } }]
      }
    },
    "page": {
      "*": {
        "background": [{ "color": { "solid": { "color": "#F4F6F8" } }, "transparency": 0 }]
      }
    }
  }
}
